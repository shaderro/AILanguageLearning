# 环境变量配置模板
# 
#  重要说明：
# 1. 复制此文件为 .env（不要提交 .env 到版本控制）
# 2. 填写你的实际值
# 3. .env 文件已添加到 .gitignore，不会被提交

# ==================== 必需的环境变量 ====================

# JWT 密钥（用于生成和验证 JWT token）
# 生产环境必须使用强随机字符串，例如：openssl rand -hex 32
JWT_SECRET=your-secret-key-change-in-production

# OpenAI API Key（用于 AI 功能）
# 从 https://platform.openai.com/api-keys 获取
OPENAI_API_KEY=sk-your-api-key-here

# 运行环境（development/testing/production）
# 开发环境：development
# 测试环境：testing
# 生产环境：production
ENV=development

# 数据库 URL（可选）
# 如果设置了此变量，将覆盖配置文件中的默认数据库路径
# 例如：sqlite:///database_system/data_storage/data/dev.db
# DATABASE_URL=sqlite:///database_system/data_storage/data/dev.db

# ==================== 可选：Resend 邮件 ====================
# 从 https://resend.com/api-keys 获取
# RESEND_API_KEY=re_xxxxxxxx
# 测试发信收件人（可与 Resend 测试发件域配合使用）
# RESEND_TEST_TO=your-email@example.com
# Magic link 邮件内「打开应用」链接的前端地址（含协议）
# FRONTEND_ORIGIN=http://localhost:5173
# 生产（自定义域）:
# FRONTEND_ORIGIN=https://www.linktext.app
# 生产（Vercel 预览）:
# FRONTEND_ORIGIN=https://linktext-language.vercel.app
# 发件人（需在 Resend 验证 linktext.app 域名；本地测试可改 onboarding@resend.dev）
# RESEND_FROM_EMAIL=auth@linktext.app
# MAGIC_LINK_TTL_MINUTES=30
# 同一邮箱重复请求 magic link 的最短间隔（秒，默认 60）
# MAGIC_LINK_RESEND_COOLDOWN_SECONDS=60
# AUTH_SESSION_TTL_DAYS=30
# 新用户首次创建账号赠送积分（默认 80，即 800_000 token）
# NEW_USER_SIGNUP_POINTS=80
# 允许跨域带 Cookie 的前端 origin（逗号分隔，勿用 *，勿带尾部 /）。
# 若设置此项会覆盖代码内默认白名单，生产务必包含 linktext.app 与 www：
# CORS_ALLOWED_ORIGINS=https://www.linktext.app,https://linktext.app,http://127.0.0.1:5173
# 前端构建（Vercel）：指向 Render 后端
# VITE_API_BASE_URL=https://ailanguagelearning.onrender.com